# Windows service only. Android stores its own settings on the phone.
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESONANCE_TOKEN=replace-with-your-random-token
# Free application key from https://acoustid.org/new-application (not a user key).
ACOUSTID_API_KEY=
# Required by MusicBrainz: replace with your real project URL or contact email.
MUSIC_USER_AGENT=Resonance/1.1 (mailto:your-real-email@example.org)
# Keep the Windows service bound to localhost.
RESONANCE_BIND=127.0.0.1
